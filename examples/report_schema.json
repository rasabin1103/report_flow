{
  "$defs": {
    "Branding": {
      "additionalProperties": false,
      "properties": {
        "company_name": {
          "default": "ASE ReportFlow",
          "maxLength": 160,
          "title": "Company Name",
          "type": "string"
        },
        "primary_color": {
          "default": "#0B1929",
          "maxLength": 2000,
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Primary Color",
          "type": "string"
        },
        "accent_color": {
          "default": "#1A8FE3",
          "maxLength": 2000,
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Accent Color",
          "type": "string"
        },
        "footer_text": {
          "default": "Generated by ASE ReportFlow",
          "maxLength": 120,
          "title": "Footer Text",
          "type": "string"
        },
        "logo_base64": {
          "anyOf": [
            {
              "maxLength": 700000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logo Base64"
        }
      },
      "title": "Branding",
      "type": "object"
    },
    "Chart": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 2000,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 2000,
          "title": "Title",
          "type": "string"
        },
        "group_by": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "items": {
                "maxLength": 2000,
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Group By"
        },
        "aggregation": {
          "default": "count_rows",
          "enum": [
            "count_rows",
            "count_non_null",
            "sum",
            "average",
            "minimum",
            "maximum",
            "distinct_count"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "column": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "time_granularity": {
          "anyOf": [
            {
              "enum": [
                "day",
                "week",
                "month",
                "quarter",
                "year"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Granularity"
        },
        "sort": {
          "default": "descending",
          "enum": [
            "ascending",
            "descending"
          ],
          "title": "Sort",
          "type": "string"
        },
        "limit": {
          "default": 15,
          "maximum": 40,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "type": {
          "enum": [
            "bar",
            "horizontal_bar",
            "line",
            "pie",
            "donut"
          ],
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "default": "",
          "maxLength": 32,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "group_by",
        "type"
      ],
      "title": "Chart",
      "type": "object"
    },
    "Column": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "maxLength": 2000,
          "title": "Source",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "string",
                "number",
                "integer",
                "date",
                "boolean"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "include": {
          "default": true,
          "title": "Include",
          "type": "boolean"
        }
      },
      "required": [
        "source"
      ],
      "title": "Column",
      "type": "object"
    },
    "Dataset": {
      "additionalProperties": false,
      "properties": {
        "sheet_name": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet Name"
        },
        "encoding": {
          "default": "utf-8-sig",
          "enum": [
            "utf-8",
            "utf-8-sig",
            "latin-1",
            "cp1252"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "delimiter": {
          "anyOf": [
            {
              "maxLength": 1,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delimiter"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "maxItems": 80,
          "title": "Columns",
          "type": "array"
        },
        "missing_policy": {
          "default": "unknown",
          "enum": [
            "exclude",
            "unknown"
          ],
          "title": "Missing Policy",
          "type": "string"
        }
      },
      "title": "Dataset",
      "type": "object"
    },
    "Filter": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "maxLength": 2000,
          "title": "Column",
          "type": "string"
        },
        "operator": {
          "enum": [
            "equals",
            "not_equals",
            "greater_than",
            "greater_or_equal",
            "less_than",
            "less_or_equal",
            "in",
            "not_in",
            "contains",
            "is_null",
            "is_not_null",
            "between"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "column",
        "operator"
      ],
      "title": "Filter",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 2000,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "title": "Label",
          "type": "string"
        },
        "operation": {
          "enum": [
            "count_rows",
            "count_non_null",
            "sum",
            "average",
            "minimum",
            "maximum",
            "distinct_count"
          ],
          "title": "Operation",
          "type": "string"
        },
        "column": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "filters": {
          "items": {
            "$ref": "#/$defs/Filter"
          },
          "maxItems": 30,
          "title": "Filters",
          "type": "array"
        },
        "unit": {
          "default": "",
          "maxLength": 32,
          "title": "Unit",
          "type": "string"
        },
        "comparison": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparison"
        }
      },
      "required": [
        "id",
        "label",
        "operation"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Report": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "default": "ASE ReportFlow",
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "subtitle": {
          "default": "",
          "maxLength": 300,
          "title": "Subtitle",
          "type": "string"
        },
        "author": {
          "default": "ASE ReportFlow",
          "maxLength": 160,
          "title": "Author",
          "type": "string"
        },
        "prepared_for": {
          "default": "",
          "maxLength": 160,
          "title": "Prepared For",
          "type": "string"
        },
        "reporting_period": {
          "default": "",
          "maxLength": 80,
          "title": "Reporting Period",
          "type": "string"
        },
        "document_reference": {
          "default": "",
          "maxLength": 80,
          "title": "Document Reference",
          "type": "string"
        },
        "confidentiality": {
          "default": "",
          "maxLength": 100,
          "title": "Confidentiality",
          "type": "string"
        },
        "language": {
          "default": "en",
          "enum": [
            "en",
            "es"
          ],
          "title": "Language",
          "type": "string"
        },
        "page_size": {
          "default": "A4",
          "enum": [
            "A4",
            "LETTER"
          ],
          "title": "Page Size",
          "type": "string"
        },
        "orientation": {
          "default": "portrait",
          "enum": [
            "portrait",
            "landscape"
          ],
          "title": "Orientation",
          "type": "string"
        },
        "template": {
          "default": "executive",
          "enum": [
            "executive",
            "detailed"
          ],
          "title": "Template",
          "type": "string"
        },
        "include_cover": {
          "default": true,
          "title": "Include Cover",
          "type": "boolean"
        },
        "cover_style": {
          "default": "compact",
          "enum": [
            "compact",
            "full"
          ],
          "title": "Cover Style",
          "type": "string"
        },
        "include_table_of_contents": {
          "default": false,
          "title": "Include Table Of Contents",
          "type": "boolean"
        },
        "include_executive_summary": {
          "default": true,
          "title": "Include Executive Summary",
          "type": "boolean"
        }
      },
      "title": "Report",
      "type": "object"
    },
    "Table": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 2000,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 2000,
          "title": "Title",
          "type": "string"
        },
        "columns": {
          "items": {
            "maxLength": 2000,
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "max_rows": {
          "default": 100,
          "maximum": 2000,
          "minimum": 1,
          "title": "Max Rows",
          "type": "integer"
        },
        "include_total": {
          "default": false,
          "title": "Include Total",
          "type": "boolean"
        },
        "group_by": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "items": {
                "maxLength": 2000,
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group By"
        },
        "aggregation": {
          "default": "count_rows",
          "enum": [
            "count_rows",
            "count_non_null",
            "sum",
            "average",
            "minimum",
            "maximum",
            "distinct_count"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "column": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "sort": {
          "default": "descending",
          "enum": [
            "ascending",
            "descending"
          ],
          "title": "Sort",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "columns"
      ],
      "title": "Table",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "report": {
      "$ref": "#/$defs/Report"
    },
    "dataset": {
      "$ref": "#/$defs/Dataset"
    },
    "filters": {
      "items": {
        "$ref": "#/$defs/Filter"
      },
      "maxItems": 30,
      "title": "Filters",
      "type": "array"
    },
    "kpis": {
      "items": {
        "$ref": "#/$defs/Metric"
      },
      "maxItems": 24,
      "title": "Kpis",
      "type": "array"
    },
    "charts": {
      "items": {
        "$ref": "#/$defs/Chart"
      },
      "maxItems": 12,
      "title": "Charts",
      "type": "array"
    },
    "tables": {
      "items": {
        "$ref": "#/$defs/Table"
      },
      "maxItems": 12,
      "title": "Tables",
      "type": "array"
    },
    "sections": {
      "items": {
        "enum": [
          "cover",
          "executive_summary",
          "kpis",
          "charts",
          "tables",
          "methodology"
        ],
        "type": "string"
      },
      "maxItems": 6,
      "title": "Sections",
      "type": "array"
    },
    "branding": {
      "$ref": "#/$defs/Branding"
    }
  },
  "title": "Config",
  "type": "object"
}